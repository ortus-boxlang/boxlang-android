/**
 * The BoxLang Application listener.
 *
 * Standard BoxLang lifecycle methods plus optional Android-specific hooks.
 * Routes live in config/Router.bx — loaded automatically at boot.
 * There is no Java/Kotlin in this app.
 */
class {

	// Pseudo-constructor: app settings
	this.name = "BoxLangWebSample";
	this.sessionManagement = false;

	// ---- Standard BoxLang lifecycle ----
	function onApplicationStart() {
		// Seed some in-memory app state for the demo.
		application.items = [ "Apple", "Banana", "Cherry" ];
		return true;
	}

	function onRequestStart( required string targetPage ) {
		return true;
	}

	// ---- Android-specific lifecycle hooks (optional; fire only because defined) ----
	function onActivityResume( event ) {
		// e.g. refresh data when the activity returns to the foreground.
	}

	function onBackPressed( event ) {
		// Returning false would consume the back press; returning true (default) lets
		// Android handle it normally.
		return true;
	}

}
